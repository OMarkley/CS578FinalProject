in httpd.conf:

    RewriteEngine   on
    #RewriteLog     ""/tmp/foo.log""  # use this for debugging
    #RewriteLogLevel        3
    RewriteCond     %{HTTP_USER_AGENT}      Windows
    RewriteRule     ^/css/style\.css$       /css/style-windows.css

