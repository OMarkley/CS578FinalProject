<td width=""100%""><img src=""http://www.cnet.com/b.gif"" width=1 height=8></td></tr>
<tr bgcolor=""#cccccc""><td colspan=2><img src=""http://www.cnet.com/b.gif"" width=1 height=1></td></tr>
